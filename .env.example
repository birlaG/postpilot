# Copy to .env and fill in. Never commit .env.

# --- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Must be the public https URL. Instagram fetches card images from {PUBLIC_BASE_URL}/media/...
PUBLIC_BASE_URL=https://yourdomain.com
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value safe: losing it makes stored account tokens unreadable.
FERNET_KEY=

# --- Database / queue (docker-compose reads these)
POSTGRES_DB=postpilot
POSTGRES_USER=postpilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/0

# --- Claude (leave the key empty for dry-run mode: placeholder posts, nothing publishable)
ANTHROPIC_API_KEY=
# Models per stage. Confirm current names in the Anthropic docs before deploying.
AI_MODEL_TRIAGE=claude-haiku-5-5
AI_MODEL_WRITE=claude-sonnet-5-5
AI_MODEL_REVIEW=claude-haiku-5-5
AI_MODEL_REVIEW_HIGH=claude-opus-5-5
# USD per million tokens, copy from the pricing page (used only for cost tracking)
PRICE_TRIAGE_IN=1
PRICE_TRIAGE_OUT=5
PRICE_WRITE_IN=3
PRICE_WRITE_OUT=15
PRICE_REVIEW_IN=1
PRICE_REVIEW_OUT=5
PRICE_REVIEW_HIGH_IN=5
PRICE_REVIEW_HIGH_OUT=25

# --- Trend sources
NEWSDATA_API_KEY=

# --- Billing. Every plan is paid. Stripe takes USD (worldwide), Razorpay takes INR (India). Set one or both.
# Stripe: create 3 recurring monthly Prices in USD, paste each id into the Plan row's stripe_price_id in /admin.
# Webhook URL: https://yourdomain.com/billing/webhook/stripe/
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay: create 3 monthly plans in INR, paste ids into razorpay_plan_id. Note: recurring payments from
# international cards are limited on Razorpay, which is why Stripe handles USD.
# Webhook URL: https://yourdomain.com/billing/webhook/razorpay/ with the subscription.* events
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Platform OAuth apps (see deploy/README-deploy.md). Redirect URI for each: PUBLIC_BASE_URL/oauth/<provider>/callback/
# YouTube; provider = google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook + Instagram; provider = meta
META_APP_ID=
META_APP_SECRET=
# provider = x
X_CLIENT_ID=
X_CLIENT_SECRET=
# provider = linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202510
VIDEO_SECONDS=8

# --- Local development without Redis: run tasks inline
# CELERY_EAGER=1
